# Railway API runtime variables. Replace placeholders in the host's secret store.
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE_POSTGRES:5432/restaurant_platform
REDIS_URL=redis://PRIVATE_REDIS:6379
WEB_URL=https://app.example.com
MAIL_FROM=Restaurant Booking <no-reply@example.com>
SMTP_URL=smtp://USER:PASSWORD@SMTP_HOST:587
# Verify proxy count before setting; DNS-only Cloudflare adds no proxy hop.
TRUST_PROXY=1

# Railway web service: set this at BUILD time, not just runtime.
NEXT_PUBLIC_API_URL=https://api.example.com
