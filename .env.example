# Copy to `.env` (git-ignored) and adjust. Never commit real credentials.
# Values below are local-development placeholders only.

NODE_ENV=development

# ---------------------------------------------------------------------------
# PostgreSQL (used by docker-compose.yml and Prisma)
# ---------------------------------------------------------------------------
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=restaurant
POSTGRES_DB=restaurant_platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql://restaurant:restaurant@localhost:5432/restaurant_platform?schema=public
# Disposable database for integration tests (truncated by the auth store contract suite).
TEST_DATABASE_URL=postgresql://restaurant:restaurant@localhost:5432/restaurant_platform_test?schema=public

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Default cache TTL in milliseconds
CACHE_TTL_MS=60000

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Web (apps/web)
# Next.js only reads env files from apps/web: put NEXT_PUBLIC_* in apps/web/.env.local.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Object storage (S3-compatible, provider not chosen yet)
# ---------------------------------------------------------------------------
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_URL=


# EMAIL
SMTP_URL=
MAIL_FROM="Restaurant Booking <no-reply@localhost>"

# THROTTLE (default limit for every route; auth routes set stricter ones)
# Window in milliseconds (not seconds, since @nestjs/throttler v5)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# Number of proxies in front of the API. Set only when deployed behind one.
TRUST_PROXY=
