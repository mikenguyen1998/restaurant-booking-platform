{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "env": [
        "NEXT_PUBLIC_*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "db:generate"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build",
        "db:generate"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "test": {
      "dependsOn": [
        "^build",
        "db:generate"
      ]
    }
  }
}
