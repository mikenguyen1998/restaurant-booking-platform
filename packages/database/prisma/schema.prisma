generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENUMS
// ======================================================

enum UserRole {
  CUSTOMER
  RESTAURANT_OWNER
  ADMIN
}

enum RestaurantStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

enum ResourceType {
  TABLE
  VIP_ROOM
}

enum ResourceStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  EXPIRED
}

enum BookingSource {
  ONLINE
  MANUAL
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum CollectionVisibility {
  PRIVATE
  PUBLIC
}

enum ReviewStatus {
  PUBLISHED
  FLAGGED
  HIDDEN
}

enum AuditActorType {
  USER
  SYSTEM
}

// ======================================================
// IDENTITY
// ======================================================

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String?  @unique
  // Set only when the owner opened a verification link sent to `email`; reset when `email` changes.
  emailVerified Boolean  @default(false)
  phone         String?  @unique
  name          String
  passwordHash  String?
  role          UserRole @default(CUSTOMER)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  ownedRestaurants Restaurant[] @relation("RestaurantOwner")

  bookingsAsCustomer Booking[] @relation("BookingCustomer")
  bookingsCreated    Booking[] @relation("BookingCreatedBy")

  reviews       Review[]
  favorites     Favorite[]
  collections   Collection[]
  notifications Notification[]

  reviewReplies     ReviewReply[]
  auditLogs         AuditLog[]
  noShowBookings    Booking[]     @relation("BookingNoShowBy")
  cancelledBookings Booking[]     @relation("BookingCancelledBy")

  @@index([role])
}

// ======================================================
// RESTAURANT
// ======================================================

model Restaurant {
  id String @id @default(uuid()) @db.Uuid

  ownerId     String  @db.Uuid
  name        String
  slug        String  @unique
  description String?

  status RestaurantStatus @default(DRAFT)

  // Location
  countryCode  String  @default("VN") @db.VarChar(2)
  city         String
  citySlug     String
  district     String?
  districtSlug String?
  address      String

  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)

  // Regional settings
  timezone     String @default("Asia/Ho_Chi_Minh")
  currencyCode String @default("VND") @db.VarChar(3)

  // Discovery
  priceLevel Int @default(2)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  owner User @relation("RestaurantOwner", fields: [ownerId], references: [id])

  resources             RestaurantResource[]
  openingHours          OpeningHour[]
  closures              RestaurantClosure[]
  bookingSettings       RestaurantBookingSetting?
  images                RestaurantImage[]
  menus                 Menu[]
  cuisines              RestaurantCuisine[]
  amenities             RestaurantAmenity[]
  bookings              Booking[]
  reviews               Review[]
  favorites             Favorite[]
  announcements         RestaurantAnnouncement[]
  combinationRules      ResourceCombinationRule[]
  collectionRestaurants CollectionRestaurant[]
  searchName            String                    @default("")

  @@index([searchName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([citySlug])
  @@index([districtSlug])
  @@index([citySlug, districtSlug])
  @@index([status, citySlug])
}

// ======================================================
// RESTAURANT DISCOVERY
// ======================================================

model Cuisine {
  id   String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  restaurants RestaurantCuisine[]
}

model RestaurantCuisine {
  restaurantId String @db.Uuid
  cuisineId    String @db.Uuid

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cuisine    Cuisine    @relation(fields: [cuisineId], references: [id], onDelete: Cascade)

  @@id([restaurantId, cuisineId])
  @@index([cuisineId])
}

model Amenity {
  id   String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique

  restaurants RestaurantAmenity[]
}

model RestaurantAmenity {
  restaurantId String @db.Uuid
  amenityId    String @db.Uuid

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  amenity    Amenity    @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([restaurantId, amenityId])
  @@index([amenityId])
}

// ======================================================
// RESTAURANT MEDIA / MENU
// ======================================================

model RestaurantImage {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @db.Uuid

  url       String
  altText   String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, sortOrder])
}

model Menu {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @db.Uuid

  name      String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@index([restaurantId, isActive])
}

model MenuItem {
  id     String @id @default(uuid()) @db.Uuid
  menuId String @db.Uuid

  name         String
  description  String?
  price        Decimal @db.Decimal(12, 2)
  currencyCode String  @db.VarChar(3)
  imageUrl     String?
  isAvailable  Boolean @default(true)
  sortOrder    Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId, isAvailable])
}

// ======================================================
// AVAILABILITY CONFIGURATION
// ======================================================

model OpeningHour {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @db.Uuid

  dayOfWeek DayOfWeek

  openTime  DateTime @db.Time(0)
  closeTime DateTime @db.Time(0)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@index([restaurantId, dayOfWeek])
}

model RestaurantClosure {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @db.Uuid

  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  reason String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, startAt, endAt])
}

model RestaurantBookingSetting {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @unique @db.Uuid

  bookingDurationMinutes   Int @default(120)
  slotIntervalMinutes      Int @default(30)
  bufferMinutes            Int @default(15)
  cancellationDeadlineMins Int @default(120)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

// ======================================================
// RESTAURANT RESOURCES
// ======================================================

model RestaurantResource {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @db.Uuid

  name     String
  type     ResourceType
  status   ResourceStatus @default(ACTIVE)
  capacity Int
  priority Int            @default(0)

  // Optional reservation/VIP fee.
  // Payment itself is intentionally out of scope for phase 1.
  reservationFeeAmount Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  bookingResources     BookingResource[]
  combinationRuleItems ResourceCombinationRuleResource[]

  @@index([restaurantId, status])
  @@index([restaurantId, type, status])
  @@index([restaurantId, capacity])
  @@index([restaurantId, priority])
}

model ResourceCombinationRule {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @db.Uuid

  name     String
  priority Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  restaurant Restaurant                        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  resources  ResourceCombinationRuleResource[]

  @@index([restaurantId, isActive, priority])
}

model ResourceCombinationRuleResource {
  ruleId     String @db.Uuid
  resourceId String @db.Uuid

  rule     ResourceCombinationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  resource RestaurantResource      @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@id([ruleId, resourceId])
  @@index([resourceId])
}

// ======================================================
// BOOKING
// ======================================================

model Booking {
  id String @id @default(uuid()) @db.Uuid

  // Human-readable booking reference
  bookingNumber String @unique

  restaurantId String  @db.Uuid
  customerId   String? @db.Uuid
  createdById  String? @db.Uuid

  status BookingStatus @default(PENDING)
  source BookingSource @default(ONLINE)

  partySize Int

  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)

  expiresAt DateTime? @db.Timestamptz(3)

  // Guest / booking contact snapshot
  guestName      String
  guestPhone     String?
  guestEmail     String?
  specialRequest String?

  // Soft resource preference.
  // Final allocation is decided by the engine.
  preferredResourceType ResourceType?

  // Lifecycle metadata
  confirmedAt DateTime? @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  noShowAt    DateTime? @db.Timestamptz(3)

  cancellationReason String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  customer User? @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: SetNull)

  createdBy User? @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  cancelledBy   User?   @relation("BookingCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledById String? @db.Uuid

  noShowBy   User?   @relation("BookingNoShowBy", fields: [noShowById], references: [id], onDelete: SetNull)
  noShowById String? @db.Uuid

  resources BookingResource[]

  review Review?

  @@index([restaurantId, startsAt, endsAt])
  @@index([restaurantId, status, startsAt])
  @@index([customerId, status, startsAt])
  @@index([createdById])
  @@index([expiresAt])
}

model BookingResource {
  id String @id @default(uuid()) @db.Uuid

  bookingId  String @db.Uuid
  resourceId String @db.Uuid

  // Allocation interval.
  // allocatedUntilAt should include restaurant buffer time.
  allocatedFromAt  DateTime @db.Timestamptz(3)
  allocatedUntilAt DateTime @db.Timestamptz(3)

  // Historical allocation remains after cancellation.
  // Only active allocations participate in conflict checks.
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  booking  Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource RestaurantResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@unique([bookingId, resourceId])
  @@index([resourceId, isActive, allocatedFromAt, allocatedUntilAt])
  @@index([bookingId, isActive])
}

// ======================================================
// FAVORITES / COLLECTIONS
// ======================================================

model Favorite {
  userId       String @db.Uuid
  restaurantId String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([userId, restaurantId])
  @@index([restaurantId])
}

model Collection {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  name       String
  visibility CollectionVisibility @default(PRIVATE)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurants CollectionRestaurant[]

  @@unique([userId, name])
  @@index([userId, visibility])
}

model CollectionRestaurant {
  collectionId String @db.Uuid
  restaurantId String @db.Uuid

  addedAt DateTime @default(now()) @db.Timestamptz(3)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([collectionId, restaurantId])
  @@index([restaurantId])
}

// ======================================================
// REVIEWS
// ======================================================

model Review {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @db.Uuid
  customerId   String @db.Uuid
  bookingId    String @unique @db.Uuid

  overallRating    Int
  foodRating       Int
  serviceRating    Int
  atmosphereRating Int

  content String?

  status ReviewStatus @default(PUBLISHED)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  editedAt  DateTime? @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  customer   User       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  reply ReviewReply?

  @@index([restaurantId, status, createdAt])
  @@index([customerId, createdAt])
}

model ReviewReply {
  id       String @id @default(uuid()) @db.Uuid
  reviewId String @unique @db.Uuid
  authorId String @db.Uuid

  content String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([authorId])
}

// ======================================================
// NOTIFICATIONS
// ======================================================

model Notification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  type  String
  title String
  body  String

  data Json?

  readAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// ======================================================
// RESTAURANT ANNOUNCEMENTS
// ======================================================

model RestaurantAnnouncement {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @db.Uuid

  title   String
  content String

  publishedAt DateTime? @db.Timestamptz(3)
  isActive    Boolean   @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, isActive, publishedAt])
}

// ======================================================
// AUDIT LOG
// ======================================================

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorType AuditActorType
  actorId   String?        @db.Uuid

  action     String
  targetType String
  targetId   String? @db.Uuid

  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
}

// ======================================================
// AUTH STATE (@nestjs/authentication stores)
// ======================================================
// Tables of the store contracts (docs.nestjs.com/security/authentication#keep-sessions-and-tokens-in-your-database),
// written only by PrismaAuthenticationStore. Tokens and links are stored as SHA-256 hashes.

// Server-side sessions (SessionStore). The API signs in with JWTs only, but the package
// revokes sessions alongside refresh tokens (password reset, sign out everywhere), so
// production requires the store. `id` is the SHA-256 of the session token.
model Session {
  id           String   @id
  // No foreign key, as in the docs: the package owns these rows.
  userId       String
  createdAt    DateTime @db.Timestamptz(3)
  expiresAt    DateTime @db.Timestamptz(3)
  lastActiveAt DateTime @db.Timestamptz(3)
  // 'pending' | 'verified' (MfaState)
  mfa          String?
  metadata     Json?

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  // SHA-256 of the token: the raw token is never stored.
  id              String    @id
  // Every rotation stays in the family of the original sign-in.
  familyId        String
  // No foreign key, as in the docs: the package owns these rows and only ever passes an id.
  userId          String
  createdAt       DateTime  @db.Timestamptz(3)
  expiresAt       DateTime  @db.Timestamptz(3)
  // The family cannot be extended past this, however often it rotates.
  familyExpiresAt DateTime  @db.Timestamptz(3)
  // Set once, by a conditional update; a second use means the token was stolen.
  usedAt          DateTime? @db.Timestamptz(3)
  // A family is revoked when any of its tokens is: that covers a successor saved after the revocation.
  revoked         Boolean   @default(false)
  // Claims fixed at sign-in (amr, auth_time, …) carried by every token of the family.
  claims          Json?

  @@index([familyId])
  @@index([userId])
  @@index([familyExpiresAt])
}

// Email verification and password reset links.
model EmailToken {
  // SHA-256 of the token in the link.
  id          String   @id
  // 'email-verification' | 'password-reset' (EmailTokenPurpose)
  purpose     String
  userId      String
  // The address the link was sent to: it verifies only while the account keeps it.
  email       String
  fingerprint String?
  createdAt   DateTime @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)

  @@index([userId, purpose])
  @@index([expiresAt])
}

// TOTP authenticator per user. `secret` arrives encrypted (AES-256-GCM) from MfaService.
// Required by @nestjs/authentication in production even before 2FA is offered:
// every sign-in looks up the user's authenticator.
model MfaAuthenticator {
  userId        String  @id
  secret        String
  confirmed     Boolean
  pendingSecret String?
  // Highest TOTP time step already accepted: a code works once.
  lastUsedStep  Int?
}

// Recovery codes, hashed with scrypt by the package.
model MfaRecoveryCode {
  userId   String
  codeHash String

  @@id([userId, codeHash])
}

// Failed second-factor attempts, counted per window to rate-limit guessing.
model MfaFailure {
  id       Int      @id @default(autoincrement())
  userId   String
  failedAt DateTime @db.Timestamptz(3)

  @@index([userId, failedAt])
  @@index([failedAt])
}
